# Copie este arquivo para .env e preencha a SUA chave.
# O .env esta no .gitignore e nunca sobe ao repositorio.
#
# Provedor padrao: Google AI Studio (Gemini), via endpoint compativel com OpenAI.
# Chave gratuita em: https://aistudio.google.com (Get API key)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Para usar Groq no lugar do Gemini, troque as tres variaveis acima por:
# LLM_API_KEY=  (chave de https://console.groq.com)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
