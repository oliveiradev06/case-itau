# Copie este arquivo para .env e preencha a SUA chave.
# O .env esta no .gitignore e nunca sobe ao repositorio.
#
# Provedor padrao: Groq, via endpoint compativel com OpenAI.
# Chave gratuita em: https://console.groq.com (API Keys > Create API Key)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Para usar Google AI Studio (Gemini) no lugar do Groq, troque as tres variaveis por:
# LLM_API_KEY=  (chave de https://aistudio.google.com)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
